include ./test.atl

0 value redis-context

: init-redis
    "Initialising redis connection.\n" type

    redis "PORT" map-get 
    0<> if
        pad strint nip
    else
        "...Get PORT Failed.\n" type
        abort 
    then

    redis "IP" map-get
    0= if
        "...Get IP Failed.\n" type
        abort 
    then

    pad swap redis-connect \ redis-context !
;

init-redis to redis-context

