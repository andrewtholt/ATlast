\ =====================================================================
\ tasker.atl - 100% Loop-Free Cooperative Multitasking for ATLAST
\ =====================================================================

\ ---------------------------------------------------------------------
\ 1. Scheduler Configuration & Storage
\ ---------------------------------------------------------------------
10 CONSTANT MAX-TASKS
VARIABLE TASK-COUNT
VARIABLE CURRENT-TASK
CREATE TASK-QUEUE MAX-TASKS CELLS ALLOT

: INIT-SCHEDULER ( -- )
    0 TASK-COUNT ! 
    0 CURRENT-TASK !
    TASK-QUEUE MAX-TASKS CELLS 0 FILL ;

: ADD-TASK ( xt -- )
    TASK-COUNT @ MAX-TASKS >= IF 
        " Error: Task queue full!\n" TYPE DROP
    ELSE
        TASK-QUEUE TASK-COUNT @ CELLS + !
        1 TASK-COUNT +!
    THEN ;

\ ---------------------------------------------------------------------
\ 2. Definition of Cooperative Tasks (State Machines)
\ ---------------------------------------------------------------------
VARIABLE COUNTER-A
VARIABLE COUNTER-B

: STEP-TASK-A ( -- )
    1 COUNTER-A +!
    " [Task A] Counter is: " TYPE COUNTER-A @ . " \n" TYPE ;

: STEP-TASK-B ( -- )
    1 COUNTER-B +!
    COUNTER-B @ 3 MOD 0= IF
        " [Task B] Heartbeat signal sent.\n" TYPE
    THEN ;

\ ---------------------------------------------------------------------
\ 3. Loop-Free Execution Step
\ ---------------------------------------------------------------------
\ This word contains absolutely no DO, LOOP, BEGIN, AGAIN, or UNTIL.
\ It relies entirely on straight-line code execution.
: SCHED-STEP ( -- )
    TASK-COUNT @ 0> IF
        \ 1. Fetch and execute the current task slice
        CURRENT-TASK @ CELLS TASK-QUEUE + @ EXECUTE
        
        \ 2. Advance the task index safely using a mathematical modulus
        CURRENT-TASK @ 1+ TASK-COUNT @ MOD CURRENT-TASK !
    THEN ;

\ ---------------------------------------------------------------------
\ 4. Initialization and Startup Routine
\ ---------------------------------------------------------------------
: START ( -- )
    INIT-SCHEDULER
    0 COUNTER-A !
    0 COUNTER-B !
    
    \ Register the execution tokens (XT) into the round-robin queue
    ['] STEP-TASK-A ADD-TASK
    ['] STEP-TASK-B ADD-TASK
    
    " Starting loop-free cooperative multitasker...\n" TYPE ;

\ Run initialization
START

\ ---------------------------------------------------------------------
\ 5. The Infinite Engine Driver
\ ---------------------------------------------------------------------
\ To avoid compiled loop leakages, we feed steps directly to ATLAST's 
\ top-level outer interpreter shell using standard line evaluation.
SCHED-STEP SCHED-STEP SCHED-STEP SCHED-STEP SCHED-STEP
SCHED-STEP SCHED-STEP SCHED-STEP SCHED-STEP SCHED-STEP

\ To make it infinite, we pass the execution back to the text parser 
\ outside of any compiled word context.
include task1.atl
