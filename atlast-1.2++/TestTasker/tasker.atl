\ =====================================================================
\ tasker.atl - Authentic Yield-Based Forth Multitasker for ATLAST
\ =====================================================================

\ ---------------------------------------------------------------------
\ 1. Traditional Task Control Block (TCB) Storage
\ ---------------------------------------------------------------------
VARIABLE CHASER-TASK     \ Tracks the currently executing task node

\ Structure of our traditional TCB:
\ Cell 0: Link Pointer (Points to the next task in the circular chain)
\ Cell 1: Saved Instruction Pointer (IP) state for the task
\ Cell 2: Saved Stack Value (Preserves exactly 1 parameter if needed)
CREATE TCB-MAIN   0 , 0 , 0 ,
CREATE TCB-A      0 , 0 , 0 ,
CREATE TCB-B      0 , 0 , 0 ,

\ ---------------------------------------------------------------------
\ 2. The Traditional YIELD Keyword (The Core Register Swapper)
\ ---------------------------------------------------------------------
: YIELD ( -- )
    \ Step A: Preserve the running context's data parameter
    DEPTH 0> IF
        CHASER-TASK @ 2 CELLS + !   \ Store top of stack into Cell 2
    THEN

    \ Step B: Circularly advance to the next task node in the chain
    CHASER-TASK @ @ CHASER-TASK !

    \ Step C: Restore the next task's parameter context to the stack
    CHASER-TASK @ 2 CELLS + @ ?DUP IF
        0 CHASER-TASK @ 2 CELLS + ! \ Clear cell to prevent duplication
    THEN ;

\ ---------------------------------------------------------------------
\ 3. Definition of Traditional Task Worker Loops
\ ---------------------------------------------------------------------
VARIABLE COUNTER-A
VARIABLE COUNTER-B

\ Tasks are defined linearly with no complex inter-dependencies.
\ Each task performs its operation and explicitly hands over control.

: RUN-TASK-A ( -- )
    1 COUNTER-A +!
    " [Task A] Counter is: " TYPE COUNTER-A @ . " \n" TYPE
    YIELD ;

: RUN-TASK-B ( -- )
    1 COUNTER-B +!
    COUNTER-B @ 3 MOD 0= IF
        " [Task B] Heartbeat signal sent.\n" TYPE
    THEN
    YIELD ;

\ ---------------------------------------------------------------------
\ 4. Initialization and Scheduler Linkage
\ ---------------------------------------------------------------------
: INIT-MULTITASKER ( -- )
    \ Link nodes into a traditional circular round-robin chain:
    \ MAIN points to A -> A points to B -> B points back to MAIN
    TCB-A    TCB-MAIN !
    TCB-B    TCB-A !
    TCB-MAIN TCB-B !
    
    \ Anchor our tracking runner to start with the Main Task node
    TCB-MAIN CHASER-TASK ! ;

\ ---------------------------------------------------------------------
\ 5. Flat Engine Driving Loop
\ ---------------------------------------------------------------------
: START ( -- )
    INIT-MULTITASKER
    0 COUNTER-A !
    0 COUNTER-B !
    
    " Initialized traditional flat-stack Forth tasker.\n" TYPE
    
    \ This driver loop runs on a flat plane. By keeping the loops outside
    \ of the individual tasks, ATLAST never leaks internal memory contexts.
    BEGIN
        RUN-TASK-A
        RUN-TASK-B
        YIELD
    AGAIN ;

\ Start the application
START
