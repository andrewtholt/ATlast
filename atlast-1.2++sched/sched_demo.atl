100 100 TASK TASK-A
100 100 TASK TASK-B

VARIABLE COUNT-A
VARIABLE COUNT-B
0 COUNT-A !
0 COUNT-B !

: LOOP-A
  BEGIN
    COUNT-A @ 1+ COUNT-A !
    65 EMIT COUNT-A @ . CR
    YIELD
    COUNT-A @ 3 <
  WHILE
  REPEAT
  99 EMIT CR
;

: LOOP-B
  BEGIN
    COUNT-B @ 1+ COUNT-B !
    66 EMIT COUNT-B @ . CR
    YIELD
    COUNT-B @ 3 <
  WHILE
  REPEAT
  100 EMIT CR
;

' LOOP-A TASK-A ACTIVATE
' LOOP-B TASK-B ACTIVATE

: MAIN-DRIVE
  10 0 DO
    YIELD
  LOOP
;
MAIN-DRIVE

.TASKS
CR 88 EMIT CR
