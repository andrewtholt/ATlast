include struct.atl

-1 constant TRUE
0 constant FALSE

255 constant /buflen
/buflen string reply

/buflen string scratch

struct
    64 chars field cmnd-topic
    64 chars field topic    \ <- Indes.
    32 chars field msg
     1 chars field msg-type \ Boole|String|Time
     1 chars field dirty
     8 chars field truth
endstruct /mqtt


: set-dirty \ flag struct-ptr --
    dirty c!
;

: set-topic   \ "topic" *struct -- 
    topic strcpy
;

: set-cmnd-topic   \ "topic" *struct -- 
    cmnd-topic strcpy
;

: get-topic \ field-addr -- PAD: content
    topic pad strcpy
;
            
: set-msg  \ "string" struct-ptr ---
    dup >r
    msg strcpy
    -1 r> set-dirty

;

: set-type \ "B|S|N" --
    msg-type c!
;

: set-truth \ "string" --
    truth strcpy
;
   
: get-dirty \ struct-ptr -- f
    dirty c@
;


: get-type \ struct-addr --- "B|S|N"
    msg-type c@
;

: msg->flag \ "On"|"Online" -- TRUE
            \ "Off"|"Offline" -- FALSE
            dup "On" strcmp swap
            "Online" strcmp and 0=
;

: get-truth 
    truth pad strcpy
;

: is-msg-true \ struct-addr -- f
    dup msg 
    swap
    truth strcasecmp 0=
;

: get-msg \ struct-addr --
    dup get-type
    case
        66 of \ B
            "Boolean\n" type
            msg pad strcpy
            pad msg->flag
        endof 
        83 of \ S
            "String\n" type 
            msg pad strcpy
        endof
        78 of \ N
            "Number\n" type 
            msg pad strcpy
            pad strint nip
        endof
    endcase

;

: test-switch ( n -- )
    case
        66 of 1000 endof
        83 of 2000 endof
        78 of 3000 endof
    endcase
;


: display \ *struct --
    dup "Cmnd Topic:\t" type cmnd-topic type cr
    dup "Topic     :\t" type topic type cr
    dup "Msg       :\t" type msg type cr
    dup "Type      :\t" type msg-type c@ emit cr
    dup "Truth     :\t" type truth type cr
        "Dirty     :\t" type dirty c@ . cr

    "----\n" type
;

10 1 cell array items
0 value item-index
0 value jacuzzi

16 string ip
0 value port
0 value sock
0 value connected-flag

: connected
    true to connected-flag
;

: ok ;

: qsize ;

: online -1 ;

: offline 0 ;

: mqtt-setup
    "MQTT_PORT" getenv
    0= if
        pad strint nip to port
    else
        "getenv failed\n" type
    then

    "MQTT_IP" getenv 0= if
        pad ip strcpy
    then

    ip port socket-connect 0= if
        to sock
        reply /buflen sock socket-recv  \ reply_len
        drop
    else
        "Failed to connect.\n" type
        abort
    then
;

: init
    here /mqtt allot to jacuzzi
    mqtt-setup
    
;

0 value  /home/Jacuzzi/POWER 

: ?qsize
    "QSIZE\n" dup strlen sock socket-send 0<> if
        "Send Failed.\n" type
        abort
    else
        drop
        reply /buflen sock socket-recv  \ reply_len
        drop reply evaluate drop
    then
;

: fread1
    "FREAD1\n" dup strlen sock socket-send 0<> if
        "Send Failed.\n" type
        abort
    else
        drop
        reply /buflen sock socket-recv  \ reply_len
        reply evaluate
        0= if
            drop
        then
    then
;

: subscribe \ "topic" --
    "Subscribe.\n" type
    "SUB " pad strcpy
    pad strcat
    "\n" pad strcat

    pad  dup strlen sock socket-send 0<> if

\    "SUB /home/Jacuzzi/POWER\n" dup strlen sock socket-send 0<> if
        "Send Failed.\n" type
        abort
    else
        drop
        reply /buflen sock socket-recv  \ reply_len
        "Result\n" type
        reply swap dump
    then
;
init
"/home/Jacuzzi/POWER" jacuzzi set-topic
\ "/home/Jacuzzi/LWT" jacuzzi set-topic
"/home/Jacuzzi/cmnd/POWER" jacuzzi set-cmnd-topic
\ "Offline" jacuzzi set-msg
\ char B  jacuzzi set-type

\ "54321" jacuzzi set-msg
\ char N  jacuzzi set-type

"Offline" jacuzzi set-msg
"Online" jacuzzi set-truth
char B  jacuzzi set-type

jacuzzi display

jacuzzi item-index items !

: test
    10 0 do
\        i dup . "\t" type items @ . cr

        i items @ ?dup 0<> if
           display 
        then
    loop
;

: init-sub
    10 0 do

        i items @ ?dup 0<> if
            i . cr
           get-topic pad scratch strcpy
           scratch 20 dump
           scratch subscribe
        then
    loop
;

init-sub

