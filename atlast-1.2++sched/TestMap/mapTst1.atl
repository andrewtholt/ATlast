
"Map test" type cr

0 value map

mk-string-map to  map 

map "Test" "One" map-add
map "TestOne" "Two" map-add

map "Test" map-get cr .
cr
pad 32 dump cr

map map-dump
cr "Number of records:" type map map-count . cr

"Delete key Test" type cr
map "Test" map-rm
cr
map map-dump
cr "Number of records:" type map map-count . cr

