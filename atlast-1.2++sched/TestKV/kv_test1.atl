

1 constant READ
2 constant WRITE
4 constant BIN-FILE
8 constant CREAT

0 value kv
16 string env

".env.txt" env s!

: init
    
    env 0 access 0= if
        "Env file exists ...\n" type
    else
        "No Env file.\n" type
        abort
    then

    kv-init to kv

    kv ".env.txt" kv-load 0= if
        "File opened\n" type
    then

;

: tst
    kv "IP" kv-exist 0<> if
        "IP: Exists\n" type
    else
        "IP: DOES NOT Exist.\n" type
    then

    kv "CRAP" kv-exist 0<> if
        "CRAP: Exists\n" type
    else
        "CRAP: DOES NOT Exist.\n" type
    then
    cr
;


init

tst

kv kv-display
